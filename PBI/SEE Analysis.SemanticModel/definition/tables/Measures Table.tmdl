	measure 'Top 1 Region name' = ```
			
			VAR regionid = 
			CALCULATE(
			    SELECTEDVALUE(Region[RegionID]),
			    KEEPFILTERS(
			        TOPN(
			            1,
			            ALL(Region),            
			            [Total CCAA Energy]
			        )
			    )
			)
			RETURN
			SWITCH(
			    SELECTEDVALUE(Languages[LanguageID]),
			    "en", 
			    CALCULATE(
			        MAX('Region'[RegionTranslateEnglish]),
			        FILTER(Region, Region[RegionID]= regionid)
			    ),
			    "es", 
			    CALCULATE(
			        MAX('Region'[RegionTranslateSpanish]),
			        FILTER(Region, Region[RegionID]= regionid)
			    ),
			    "pt",
			    CALCULATE(
			        MAX('Region'[RegionTranslatePortuguese]),
			        FILTER(Region, Region[RegionID]= regionid)
			    )
			)
			```
		displayFolder: Card_Regions\Top1
		lineageTag: 1b378b7f-aa93-44cb-9da7-0755d294e13a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 1 Region' = ```
			
			CALCULATE(
			    [Energy CCAA (GWh)],
