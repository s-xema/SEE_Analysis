	measure YOY =
			
			VAR PY = CALCULATE(
			    [Energy CCAA (GWh)],
			    SAMEPERIODLASTYEAR('Calendar'[Date])
			)
			
			RETURN DIVIDE(([Energy CCAA (GWh)] - PY), PY)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: CCAA
		lineageTag: 9dc0d748-cf86-484a-9b39-eea299a3417a

