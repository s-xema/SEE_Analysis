	measure 'AVG Generation Previous Years (GWh)' =
			
			IF(
			    SELECTEDVALUE(Source[CategoryId]) = "3",
			    BLANK(),
			    DIVIDE(
					CALCULATE(
			            [Generation (GWh)],
			            'Calendar'[Year] < SELECTEDVALUE('Calendar'[Year])
			        ),
					CALCULATE(
						DISTINCTCOUNT('Calendar'[Year]),
			            'Calendar'[Year] < SELECTEDVALUE('Calendar'[Year])
			        )
				)
			)
		formatString: #,0
		displayFolder: Auxiliar
		lineageTag: 10facb82-c678-4e12-818a-dbbd74406d29

	measure 'Generation Selected Year (GWh)' =
			
			IF(
			    SELECTEDVALUE(Source[CategoryId]) = "3",
