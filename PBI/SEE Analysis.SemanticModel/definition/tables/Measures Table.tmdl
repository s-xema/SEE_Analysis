	measure 'Top 1 Power' = ```
			
			VAR RegionsAndEnergy = 
			    ADDCOLUMNS(
			        VALUES(Source[SourceId]),
			        "rank", RANKX(Source, [Power (MW)])
			    )
			VAR _1Region = 
			MINX(
			    FILTER(
			        RegionsAndEnergy,
			        [rank] = 1
			    ),
			    [Power (MW)]
			)
			
			RETURN
			_1Region
