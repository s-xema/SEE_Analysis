		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 1 Power name' = ```
			
			VAR RegionsAndEnergy = 
			    ADDCOLUMNS(
			        VALUES(Source[SourceId]),
			        "rank", RANKX(Source, [Power (MW)])
			    )
			VAR _1Region = 
			MINX(
			    FILTER(
			        RegionsAndEnergy,
			        [rank] = 1
			    ),
			    Source[SourceId]
			)
			
			RETURN
			
			SWITCH(
			    SELECTEDVALUE(Languages[LanguageID]),
			    "en", 
			    CALCULATE(
			        MAX('Source'[SourceTranslationEnglish]),
			        FILTER(Source, Source[SourceId] = _1Region)
			    ),
			    "es", 
			    CALCULATE(
			        MAX('Source'[SourceTranslationSpanish]),
			        FILTER(Source, Source[SourceId] = _1Region)
			    ),
			    "pt",
			    CALCULATE(
			        MAX('Source'[SourceTranslationPortuguese]),
			        FILTER(Source, Source[SourceId] = _1Region)
			    )
			)
			```
		displayFolder: Card_Power\Top1
		lineageTag: 14746dd7-1b29-40fb-a9e8-73dc461b9c10

