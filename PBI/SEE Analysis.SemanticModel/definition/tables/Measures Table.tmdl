		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Top 1 Source name' = ```
			
			VAR SourceAndEnergy = 
			    ADDCOLUMNS(
			        VALUES(Source[SourceId]),
			        "rank", RANKX(Source, [Generation (GWh)])
			    )
			VAR _1Source = 
			MINX(
			    FILTER(
			        SourceAndEnergy,
			        [rank] = 1
			    ),
			    Source[SourceId]
			)
			RETURN
			SWITCH(
			    SELECTEDVALUE(Languages[LanguageID]),
			    "en", 
			    CALCULATE(
			        MAX('Source'[SourceTranslationEnglish]),
			        FILTER(Source, Source[SourceId] = _1Source)
			    ),
			    "es", 
			    CALCULATE(
			        MAX('Source'[SourceTranslationSpanish]),
			        FILTER(Source, Source[SourceId] = _1Source)
			    ),
			    "pt",
			    CALCULATE(
			        MAX('Source'[SourceTranslationPortuguese]),
			        FILTER(Source, Source[SourceId] = _1Source)
			    )
			)
			```
		displayFolder: Card_Source\Top1
		lineageTag: bebd9176-a682-4809-8e3f-7bc735c44b7b

