	measure 'Top 2 Region' = ```
			
			VAR RegionsAndEnergy = 
			    ADDCOLUMNS(
			        VALUES(Region[RegionID]),
			        "rank", RANKX(Region, [Energy CCAA (GWh)])
			    )
			VAR _2Region = 
			MINX(
			    FILTER(
			        RegionsAndEnergy,
			        [rank] = 2
			    ),
			    [Energy CCAA (GWh)]
			)
			
			RETURN
			_2Region
