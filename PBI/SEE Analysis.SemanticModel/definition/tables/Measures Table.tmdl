	measure 'Top 1 Source YOY Label' = ```
			
			VAR _Value = FORMAT([Top 1 Source YOY%], "##0.##%", "es-ES")
			VAR _Arrow = 
			SWITCH(
			    TRUE(),
			    [Top 1 Source YOY%]>0, UNICHAR(129129),
			    [Top 1 Source YOY%]<0, UNICHAR(129131)
			)
			VAR _Space = REPT(" ",2)
			VAR _Label = UNICHAR(10)&"YOY:"&_Space & _Value & " " & _Arrow
			RETURN 
			    _Label
			```
