	measure 'Energy Balance each Year to Month Last Update' =
			IF(
					HASONEFILTER('Calendar'[Year]) &&
					NOT (ISFILTERED('Calendar'[MonthNameEN])|| ISFILTERED('Calendar'[MonthNameES]) || ISFILTERED('Calendar'[MonthNamePT])),
					CALCULATE(
						SUM('fact_balance'[Energy]) / 1000000,
						FILTER(
							'Calendar',
							MONTH('Calendar'[Date]) <= [MonthLastUpdate (Balance)]
						)
					)
				)
		formatString: #,0
		displayFolder: Auxiliar
		lineageTag: a559e0c0-f9c5-4007-91ac-792e475302f3

	measure 'Energy Inter each Year to Month Last Update' =
			IF(
					HASONEFILTER('Calendar'[Year]) &&
					NOT (ISFILTERED('Calendar'[MonthNameEN])|| ISFILTERED('Calendar'[MonthNameES]) || ISFILTERED('Calendar'[MonthNamePT])),
					CALCULATE(
						SUM(fact_inter[Energy]) / 1000000,
						FILTER(
							'Calendar',
							MONTH('Calendar'[Date]) <= [MonthLastUpdate (Inter)]
						)
					)
				)
		formatString: #,0
		displayFolder: Auxiliar
		lineageTag: c3cf6b57-acae-4e49-b65e-738fa4dd31dd

	measure 'Energy CCAA each Year to Month Last Update' =
			IF(
					HASONEFILTER('Calendar'[Year]) &&
					NOT (ISFILTERED('Calendar'[MonthNameEN])|| ISFILTERED('Calendar'[MonthNameES]) || ISFILTERED('Calendar'[MonthNamePT])),
					CALCULATE(
						SUM(fact_ccaa[Energy]) / 1000,
						FILTER(
							'Calendar',
							MONTH('Calendar'[Date]) <= [MonthLastUpdate (CCAA)]
						)
					)
				)
		formatString: #,0
		displayFolder: CCAA
		lineageTag: e97b6bf9-f54e-413b-a406-e24884eb734f

